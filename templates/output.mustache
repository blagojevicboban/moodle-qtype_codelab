{{!
    @template qtype_codelab/output

    One output of a test (expected or got), line by line: spaces at the end of a line are already visible in the text,
    the line that differs from the other output is marked.

    Context variables required for this template:
    * lines - list of {text, differs}

    Example context (json):
    {
        "lines": [{"text": "Sum: 5", "differs": false}, {"text": "Average: 2.5·", "differs": true}]
    }
}}
<pre class="qtype_codelab-output">{{#lines}}<span class="qtype_codelab-line{{#differs}} qtype_codelab-line-diff{{/differs}}">{{text}}</span>
{{/lines}}</pre>
