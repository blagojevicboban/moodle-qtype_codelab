{{!
    @template qtype_codelab/testcompare

    A failed test in "Run the tests" of the attempt: the input, the expected output and the output of the program side
    by side, as in the feedback after the answer is submitted.

    Context variables required for this template:
    * stdin - the input of the test, empty when it has none
    * expected - {lines} of the expected output, see qtype_codelab/output
    * got - {lines} of the output of the program

    Example context (json):
    {
        "stdin": "2 3",
        "expected": {"lines": [{"text": "5", "differs": true}]},
        "got": {"lines": [{"text": "6", "differs": true}]}
    }
}}
<div class="qtype_codelab-compare">
    {{#stdin}}
    <div class="qtype_codelab-compare-col">
        <div class="small fw-bold">{{#str}}teststdin, qtype_codelab{{/str}}</div>
        <pre class="qtype_codelab-output">{{stdin}}</pre>
    </div>
    {{/stdin}}
    <div class="qtype_codelab-compare-col">
        <div class="small fw-bold">{{#str}}testexpected, qtype_codelab{{/str}}</div>
        {{#expected}}{{> qtype_codelab/output }}{{/expected}}
    </div>
    <div class="qtype_codelab-compare-col">
        <div class="small fw-bold">{{#str}}testgot, qtype_codelab{{/str}}</div>
        {{#got}}{{> qtype_codelab/output }}{{/got}}
    </div>
</div>
